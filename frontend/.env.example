# Copy to .env and restart `npm start` (CRA reads env at startup only).

REACT_APP_API_URL=https://localhost:8000

# Cloudflare Turnstile — public site key (pair with TURNSTILE_SECRET_KEY on backend).
# Production: copy site key from Cloudflare Turnstile dashboard.
# Local: add localhost + 127.0.0.1 to the widget hostname list in Cloudflare,
#   OR use Cloudflare test keys (site + secret must both be test keys):
#   REACT_APP_TURNSTILE_SITE_KEY=1x00000000000000000000AA
REACT_APP_TURNSTILE_SITE_KEY=
