# Copy to .env and fill in real values. Do not commit .env.

# --- Edition ---
# community (default): no billing UI/APIs
# cloud: requires private archian-cloud package (see ARCHIAN_CLOUD_VERSION)
# ARCHIAN_EDITION=community
# ARCHIAN_CLOUD_VERSION=v0.1.0

# --- Core (required) ---
# DB_URL=postgresql://user:pass@localhost:5432/edison_dev_db
# REDIS_URL=redis://localhost:6379/0
# JWT_SECRET=change-me
# Fernet key for SQL connector passwords (url-safe base64). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SQL_CONNECTOR_ENCRYPTION_KEY=
# JWT_EXPIRY_SECONDS=86400
# JWT_PRE_MFA_EXPIRY_SECONDS=600
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_SEC=900
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=true
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Local defaults when unset: http://localhost:3000 / http://localhost:8000
# FRONTEND_URL=http://localhost:3000
# BACKEND_URL=http://localhost:8000
# Hosted: set your public origins; extras are comma-separated.
# CORS_ALLOWED_ORIGINS=https://www.example.com
# TRUSTED_HOSTS=api.example.com,*.example.com
# BACKEND_HOST=api.example.com
# SUPPORT_EMAIL=support@example.com
# CONTACT_TO_EMAIL=support@example.com

# --- Salesforce OAuth (optional connector) ---
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_EDISON_CLIENT_ID=
# SALESFORCE_EDISON_CLIENT_SECRET=
# SALESFORCE_EDISON_SANDBOX_CLIENT_ID=
# SALESFORCE_EDISON_SANDBOX_CLIENT_SECRET=

# --- File storage ---
# community / self-host: local disk (default when FILE_STORAGE=auto and no AWS keys)
# FILE_STORAGE=local
# LOCAL_UPLOAD_DIR=./data/uploads
# Optional object storage (never defaults to an Archian-owned bucket):
# FILE_STORAGE=s3
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Optional tuning (non-feature flags) ---
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# PIPELINE_LEARNING_TOP_K=5
# GSHEETS_CHAT_MAX_ROWS=2000
# GSHEETS_CONTEXT_CACHE_TTL=600
# ENTERPRISE_GRAPH_DAA_CONCURRENCY=3
# ASSESSMENT_SSE_POLL_INTERVAL=1.0
# LABELING_MAX_CONCURRENCY=5
# LABELING_BATCH_SIZE=10
# LABELING_REFINEMENT_DEBOUNCE_SEC=60
# TURNSTILE_SECRET_KEY=from-cloudflare-turnstile-dashboard
# MIGRATION_EXPORT_MAX_RECORDS=50000

# Plan approval is controlled in the chat UI (Ask vs Act → plan_auto_run), not server env.

# Optional: development | staging | production (logged at startup)
# DEPLOYMENT_STAGE=development

# Optional verbose logging (off by default)
# POST_EXTRACT_DEBUG=true
# AGENT_RUNTIME_DEBUG=true
# SF_EXTRACT_DEBUG=true

# Agent trace replay / quotas (optional tuning — off by default)
# AGENT_TRACE_REPLAY_ENABLED=true
# AGENT_TRACE_RETRIEVAL_POLICY=user_then_platform
# AGENT_PLATFORM_TRACE_MIN_SUCCESS_RATE=0.85
# AGENT_MAX_LLM_PICKS_PER_TURN=8
# AGENT_MAX_REPLAY_PICKS_PER_TURN=12
# AGENT_MAX_TOOL_INVOKES_PER_TURN=12
