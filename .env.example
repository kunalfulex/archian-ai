# Root quickstart — copy to `.env` for docker-compose variable substitution.
# Prefer also copying backend/.env.example → backend/.env for local non-Docker runs.

# Community edition (default). Hosted/cloud installs set ARCHIAN_EDITION=cloud
# and install the private archian-cloud package at build time.
ARCHIAN_EDITION=community

# Required for local API auth and connectors
JWT_SECRET=change-me-local-dev-only
DB_URL=postgresql://archian:archian@postgres:5432/archian
REDIS_URL=redis://redis:6379/0

# At least one LLM key (OpenAI used by default paths)
OPENAI_API_KEY=

# File storage (community default: local disk — not Archian cloud S3)
# Docker Compose mounts archian_uploads → /data/uploads
FILE_STORAGE=local
LOCAL_UPLOAD_DIR=/data/uploads
# Optional S3 (self-hosted or cloud only) — set FILE_STORAGE=s3 and:
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# URLs (docker-compose frontend → backend)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
REACT_APP_API_URL=http://localhost:8000

# Optional — Salesforce / Google OAuth (leave blank for file + SQL/CSV only)
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# See docs/SALESFORCE_SSO_SETUP.md and backend/.env.example for full lists.
